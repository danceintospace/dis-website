<!-- Contact Section -->
<section
  id="contact"
  class="py-16 lg:py-20 md:py-16 sm:py-12 px-4 md:px-8 sm:px-6 bg-white"
>
  <div class="container mx-auto">
    <h2 class="text-3xl font-bold mb-6 text-center">Contact Us</h2>

    <!-- Contact Details -->
    <div class="text-center mb-8">
      <p class="mb-2 text-gray-700">
        <a href="mailto:info@danceintospace.org" class="text-indigo-900 hover:underline">
          info@danceintospace.org
        </a>
      </p>
      <p class="text-gray-700">
        <a href="tel:+254754483075" class="hover:underline">+254 754 483 075</a>
      </p>
    </div>

    <!-- Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <!-- Google Map -->
      <div class="w-full h-[300px] md:h-[450px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m13!1m8!1m3!1d4599.008857861218!2d34.344381787942915!3d0.002068545451384367!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMMKwMDAnMDcuMiJOIDM0wrAyMCc0Mi4zIkU!5e0!3m2!1sen!2ske!4v1742037990712!5m2!1sen!2ske"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <!-- Contact Form -->
      <div>
        <form
          id="contactForm"
          action="https://formspree.io/f/mgveyrge"
          method="POST"
          class="bg-gray-50 p-6 rounded-lg shadow max-w-lg mx-auto"
        >
          <div class="mb-4">
            <label class="block mb-1 font-semibold">Your name:</label>
            <input
              type="text"
              name="name"
              required
              class="px-4 py-2 rounded border w-full focus:ring-2 focus:ring-indigo-600 focus:outline-none"
              />
          </div>

          <div class="mb-4">
            <label class="block mb-1 font-semibold">Your email:</label>
            <input
              type="email"
              name="email"
              required
              class="px-4 py-2 rounded border w-full focus:ring-2 focus:ring-indigo-600 focus:outline-none"
              />
          </div>

          <div class="mb-4">
            <label class="block mb-1 font-semibold">Your message:</label>
            <textarea
              name="message"
              required
              rows="5"
              class="px-4 py-2 rounded border w-full focus:ring-2 focus:ring-indigo-600 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="block mx-auto bg-indigo-900 text-white px-6 py-2 rounded-lg hover:bg-gray-800 transition"
          >
            Submit
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
    // Clear form after successful submission
    document.getElementById("contactForm").addEventListener("submit", function (event) {
        setTimeout(() => this.reset(), 100);
    });
</script>
